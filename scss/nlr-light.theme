{
  "_comment": "No Lab Required syntax theme. Spec B5: highlighting must use weight and italic in addition to hue, so it still reads on a black-and-white printer. Every distinction below is carried by at least one non-colour attribute.",
  "text-color": "#1a1a1a",
  "background-color": null,
  "line-number-color": "#9a9a9a",
  "line-number-background-color": null,
  "text-styles": {
    "Other":            { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Attribute":        { "text-color": "#0b6e6e", "background-color": null, "bold": false, "italic": false, "underline": false },
    "SpecialString":    { "text-color": "#2e6b3e", "background-color": null, "bold": false, "italic": true,  "underline": false },
    "Annotation":       { "text-color": "#7a7a7a", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Function":         { "text-color": "#1a1a1a", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "String":           { "text-color": "#2e6b3e", "background-color": null, "bold": false, "italic": false, "underline": false },
    "ControlFlow":      { "text-color": "#0b6e6e", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "Operator":         { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Error":            { "text-color": "#b5651d", "background-color": null, "bold": true,  "italic": false, "underline": true  },
    "BaseN":            { "text-color": "#b5651d", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Alert":            { "text-color": "#b5651d", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "Variable":         { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "BuiltIn":          { "text-color": "#0b6e6e", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Extension":        { "text-color": "#1a1a1a", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Preprocessor":     { "text-color": "#7a7a7a", "background-color": null, "bold": false, "italic": true,  "underline": false },
    "Information":      { "text-color": "#7a7a7a", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "VerbatimString":   { "text-color": "#2e6b3e", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Warning":          { "text-color": "#b5651d", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Documentation":    { "text-color": "#5a5a5a", "background-color": null, "bold": false, "italic": true,  "underline": false },
    "Import":           { "text-color": "#0b6e6e", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "Char":             { "text-color": "#2e6b3e", "background-color": null, "bold": false, "italic": false, "underline": false },
    "DataType":         { "text-color": "#0b6e6e", "background-color": null, "bold": true,  "italic": false, "underline": false },
    "Float":            { "text-color": "#b5651d", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Comment":          { "text-color": "#7a7a7a", "background-color": null, "bold": false, "italic": true,  "underline": false },
    "CommentVar":       { "text-color": "#7a7a7a", "background-color": null, "bold": true,  "italic": true,  "underline": false },
    "Constant":         { "text-color": "#b5651d", "background-color": null, "bold": false, "italic": false, "underline": false },
    "SpecialChar":      { "text-color": "#b5651d", "background-color": null, "bold": false, "italic": false, "underline": false },
    "DecVal":           { "text-color": "#b5651d", "background-color": null, "bold": false, "italic": false, "underline": false },
    "Keyword":          { "text-color": "#0b6e6e", "background-color": null, "bold": true,  "italic": false, "underline": false }
  }
